programa
{
	
	funcao inicio()
	{
		inteiro veti[4], n, s, i
		caracter vets[4]
		cadeia vetn[4]

		escreva("insira os dados em suas respectivas ordens, nome, idade e sexo (sendo M, masculino e F feminino10:\n")

		
		para(i = 0; i < 4; i++){
		escreva("Insira o nome:")
		leia(vetn[i])
		escreva("Insira a idade:")
		leia(veti[i])
		escreva("Insira o sexo, sendo M para masculino e F para feminino:")
		leia(vets[i])
		}

		para(i = 0; i < 4; i++){
			se()
		}
		
		
	}
}
