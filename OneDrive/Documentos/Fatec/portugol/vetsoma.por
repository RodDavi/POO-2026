programa
{
	
	funcao inicio()
	{
		inteiro vet1[2], vet2[2], i, soma
		
		
			escreva("Digite os valores do primerio vetor:\n")
		para(i = 0; i < 2; i++){
			leia(vet1[i])
		}
			escreva("Digite os valores do segundo vetor:\n")
		para(i = 0; i < 2; i++){
			leia(vet2[i])
		}
		para (i = 0; i < 2; i++){
		escreva(vet1[i] + vet2[i])
		}
	}
}
